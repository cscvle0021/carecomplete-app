{
  "name": "blink-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 npx expo start --web --port 3000",
    "start": "EXPO_NO_TELEMETRY=1 npx expo start",
    "start:web": "EXPO_NO_TELEMETRY=1 npx expo start --web",
    "start:ios": "EXPO_NO_TELEMETRY=1 npx expo start --ios",
    "start:android": "EXPO_NO_TELEMETRY=1 npx expo start --android",
    "build:web": "EXPO_NO_TELEMETRY=1 npx expo export --platform web",
    "build:ios": "EXPO_NO_TELEMETRY=1 eas build --platform ios",
    "build:android": "EXPO_NO_TELEMETRY=1 eas build --platform android",
    "eject": "EXPO_NO_TELEMETRY=1 npx expo eject",
    "setup": "EXPO_NO_TELEMETRY=1 npx expo install",
    "install:bun": "bun install",
    "install:fast": "bun install --no-postinstall",
    "add": "bun add",
    "doctor": "EXPO_NO_TELEMETRY=1 npx expo doctor",
    "upgrade": "EXPO_NO_TELEMETRY=1 npx expo upgrade",
    "lint": "EXPO_NO_TELEMETRY=1 npx expo lint",
    "prebuild": "EXPO_NO_TELEMETRY=1 npx expo prebuild",
    "prebuild:clean": "EXPO_NO_TELEMETRY=1 npx expo prebuild --clean"
  },
  "dependencies": {
    "@blinkdotnew/mobile-ui": "2.0.1",
    "@blinkdotnew/sdk": "2.10.1",
    "@expo/vector-icons": "^15.0.3",
    "@legendapp/list": "^2.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~57.0.26",
    "expo-av": "~16.0.7",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
